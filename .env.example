PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins.
CLIENT_URL=http://localhost:3000

# MongoDB (Atlas recommended for transactions).
MONGODB_URI=
MONGODB_DB_NAME=booknook

# Better Auth JWT verification.
# JWKS endpoint of the Better Auth client deployment.
JWT_JWKS_URL=https://your-client.vercel.app/api/auth/jwks
# Must match the Better Auth `jwt.issuer` (the client URL).
JWT_ISSUER=https://your-client.vercel.app
# Must match the Better Auth `jwt.audience` (this API's public URL).
JWT_AUDIENCE=https://your-server.vercel.app
